{
  "manifest_version": 2,
  "id": "github.jiakeju.token-ledger",
  "version": "0.1.1",
  "name": "麦麦不贪吃（Token Ledger）",
  "description": "读取宿主 token 用量，按自维护价格库（支持峰谷价、星期与节假日）重算费用，提供按群与按模型的图表看板，并给出工具调用费估算。只读数据库，不发消息。",
  "author": {
    "name": "JJK",
    "url": "https://github.com/JiaKeJu"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/JiaKeJu/maibot-ledger",
    "homepage": "https://github.com/JiaKeJu/maibot-ledger",
    "documentation": "https://github.com/JiaKeJu/maibot-ledger#readme",
    "issues": "https://github.com/JiaKeJu/maibot-ledger/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.8.0",
    "max_version": "2.21.99"
  },
  "dependencies": [],
  "plugin_type": "data",
  "capabilities": [
    "database.get"
  ],
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png"
    }
  },
  "i18n": {
    "default_locale": "zh-CN"
  }
}
